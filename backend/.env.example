# Modern Chain Link Company API Environment Configuration
PROJECT_NAME="Modern Chain Link Company API"
VERSION="2.0.0"
API_V1_STR="/api/v1"

# Production Secret Key (Generate using: openssl rand -hex 32)
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite for local / PostgreSQL for Production)
# SQLite Example: sqlite:///./mclc.db
# PostgreSQL Example: postgresql://postgres:password@railway.app:5432/railway
DATABASE_URL="sqlite:///./mclc.db"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "https://your-vercel-app.vercel.app"]
